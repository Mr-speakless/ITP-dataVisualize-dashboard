REACT_APP_C19_CONTACT=
# Data warehouse root. The original host (jht1493.net/COVID-19-Impact/Dashboard/a0)
# went offline (404). Repointed to the upstream parsed-data repo it was built from,
# served via the jsDelivr CDN (CORS-enabled, cached). Structure is identical:
#   <root>/c_data/world/c_meta.json | c_days/<date>.json | c_series/<region>.json | c_subs/...
# Source repo: https://github.com/EP-Visual-Design/COVID-19-parsed-data
REACT_APP_C19_C_DATA=https://cdn.jsdelivr.net/gh/EP-Visual-Design/COVID-19-parsed-data@main
VITE_C19_C_DATA=https://cdn.jsdelivr.net/gh/EP-Visual-Design/COVID-19-parsed-data@main
